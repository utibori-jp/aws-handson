# terraform.tfvars.example
# このファイルをコピーして terraform.tfvars を作成し、実際の値を入力してください。
# terraform.tfvars は .gitignore 対象です。コミットしないでください。

# 00_Baseline の apply 後に以下で取得できます。
#   cd ../../00_Baseline
#   terraform output learner_account_id

learner_account_id = "123456789012"

# Athena から Security Lake テーブルにアクセスするための Lake Formation 管理者ロール ARN。
# IAM Identity Center の learner-admin 権限セットに紐づく SSO ロールを指定します。
# 以下のコマンドで取得できます（learner アカウントで実行）：
#   aws iam list-roles \
#     --profile learner-admin \
#     --query 'Roles[?starts_with(RoleName, `AWSReservedSSO_scs-handson-learner-admin`)].Arn' \
#     --output text

lakeformation_admin_role_arn = "arn:aws:iam::123456789012:role/aws-reserved/sso.amazonaws.com/ap-northeast-1/AWSReservedSSO_scs-handson-learner-admin_xxxxxxxxxxxxxxxx"
