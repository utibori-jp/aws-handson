# terraform.tfvars.example
# このファイルをコピーして terraform.tfvars を作成し、実際の値を入力してください。
# terraform.tfvars は .gitignore 対象です。コミットしないでください。

# 管理アカウントの AWS SSO プロファイル。
# assume_role 経由で Learner アカウントにデプロイする。
aws_profile = "terraform-sso"

# 00_Baseline の apply 後に以下で取得できます。
#   cd ../../00_Baseline
#   terraform output learner_account_id
learner_account_id = "123456789012"

# 修復実行時に SNS メール通知を受け取るアドレス（空文字にすると通知なし）。
# apply 後に確認メールが届くので「Confirm subscription」をクリックする。
alert_email = "your-email@example.com"
